# ════════════════════════════════════════════════════════════════
#  TarbooBot — متغيرات البيئة  (انسخ هذا الملف إلى .env)
#  ⚠️ لا تضع أي مفتاح داخل config.js — الأسرار هنا فقط.
# ════════════════════════════════════════════════════════════════

# ── هوية البوت ──────────────────────────────────────────────────
MAROBOT_PRIMARY_NUMBER=
MAROBOT_PRIORITY_SUBBOTS=

# ── كونسول المطوّر (تنفيذ كود/أوامر شل) ─────────────────────────
# 🔴 خطير: يمنح تنفيذ كود كامل بصلاحيات العملية. اتركه false في الإنتاج.
MAROBOT_DEV_CONSOLE=false
MAROBOT_DEV_SHELL=false

# ── مفاتيح الخدمات الخارجية ─────────────────────────────────────
GOOGLE_API_KEY=
GROQ_API_KEY=
COVENANT_API_KEY=
LOLHUMAN_API_KEY=
NEOXR_API_KEY=
FGSI_API_KEY=
BETABOTZ_API_KEY=
ONLYM_API_KEY=
OBSCURA_API_KEY=
FIREFLY_API_KEY=
CUKI_API_KEY=

# ── مزودو الذكاء الاصطناعي ──────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=
ANTHROPIC_MAX_TOKENS=
NVIDIA_API_KEY=
NVIDIA_API_KEYS=
MANUS_API_KEY=
MANUS_API_BASE_URL=
FIXCODE_API_KEY=
ASSEMBLYAI_KEY=

# ── جسر Manus / الويب هوك ───────────────────────────────────────
MAROBOT_BRIDGE_URL=
MAROBOT_WEBHOOK_TOKEN=

# ── خدمات الوسائط والبحث ────────────────────────────────────────
SOUNDCLOUD_CLIENT_ID=
SPOTIFY_DL_API_TOKEN=
SPOTIFY_DL_META_URL=
SPOTIFY_DL_CONVERT_URL=
SPOTIFY_DL_TASK_URL=
SPOTIFY_DL_POLL_MS=
SPOTIFY_DL_MAX_POLLS=
SPOTIFY_DL_TIMEOUT_MS=
TIKTOK_SEARCH_API_KEY=
TIKTOK_SEARCH_API_URL=
TIKTOK_SEARCH_FALLBACK_URL=
EMOJI_KITCHEN_API_KEY=
IMGDROP_COOKIE=

# ── تشخيص ───────────────────────────────────────────────────────
DEBUG_PLUGINS=false

# ── Cloudflare Workers AI (توليد الصور) ─────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Monica AI ───────────────────────────────────────────────────
MONICA_SESSION_ID=
MONICA_CLIENT_ID=

# ── TopMedia TTS ────────────────────────────────────────────────
TOPMEDIA_API_KEY=

# ── تشخيص: تتبّع كل عملية إرسال (شغّله فقط عند وجود مشكلة) ──────
MAROBOT_TRACE_SEND=false
